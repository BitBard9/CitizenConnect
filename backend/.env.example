PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
# Atlas Network Access must allow this machine/Docker outbound IP (or 0.0.0.0/0 for local).
# Vite: http://localhost:5173
# Docker Compose: http://localhost
FRONTEND_URL=http://localhost:5173
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Firebase web app config (Project settings > General > Your apps).
# Read by the frontend container at start (docker/firebase-config.sh), not by the backend.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
