# Optional. Defaults to /api (Vite proxy in development, Nginx in Docker).
# Do not put secrets here. Build-time only.
VITE_API_URL=/api

# Optional fallback: Firebase web app config for running Vite without the backend.
# Normally the browser gets it from the backend at /api/config.js (FIREBASE_* in backend/.env).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
