# Optional. Defaults to /api (Vite proxy in development, Nginx in Docker).
# Do not put secrets here. Build-time only.
VITE_API_URL=/api

# Vite dev only: Firebase web app config. Put real values in frontend/.env.local.
# Docker reads FIREBASE_* from backend/.env at container start instead.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
